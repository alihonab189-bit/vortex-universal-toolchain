// VORTEX — অসমীয়াত প্ৰ'গ্ৰামিং (Assamese keywords)
ধৰো নাম = "অসম";
ধৰো বয়স = 50;

যদি (বয়স >= 18) {
    দেখুৱাওক(নাম + " — ভোট দিব পাৰে");
} নহলে {
    দেখুৱাওক("সৰু ছাত্র");
}

লুপ i ভিতৰত 1..4 {
    দেখুৱাওক("ঘূৰণ " + i);
}

কাম যোগফল(a, b) {
    দিয়ক a + b;
}

দেখুৱাওক("১০ + ২০ = " + যোগফল(10, 20));
